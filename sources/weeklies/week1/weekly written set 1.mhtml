ndex: 1000; height: 94vh; width: 237px; overflow: hidden auto; transition: =
0.5s; top: 65px; }

.uuu-icon-sidebar, .uuu-icon-sidebar ul { width: 57px; transition: 0.5s; }

.uuu-left-sidebar ul::-webkit-scrollbar { width: 6px; }

.uuu-left-sidebar ul::-webkit-scrollbar-track { background: rgb(241, 241, 2=
41); }

.uuu-left-sidebar ul::-webkit-scrollbar-thumb { background: rgb(136, 136, 1=
36); }

.uuu-left-sidebar ul::-webkit-scrollbar-thumb:hover { background: rgb(85, 8=
5, 85); }

.uuu-left-sidebar ul li { border-bottom: 1px solid rgba(128, 128, 128, 0.18=
); }

.uuu-left-sidebar ul li a { padding: 10px 15px; font-size: 17px; display: f=
lex; align-items: center; }

.uuu-left-sidebar ul li a.active, .uuu-left-sidebar ul li a:hover { backgro=
und-color: rgb(239, 234, 239); }

.uuu-left-sidebar ul li a span { margin-left: 5px; line-height: 20px; font-=
family: Roboto; }

.uuu-left-sidebar ul li a img { width: 30px; height: 30px; min-width: 30px;=
 }

