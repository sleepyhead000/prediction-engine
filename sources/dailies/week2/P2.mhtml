@charset "utf-8";

body { overflow-x: hidden; }

.container { max-width: 100% !important; }

.row { row-gap: 24px; }

.bg-shadow { background: rgb(230, 223, 230); border-radius: 10px; box-shado=
w: rgba(0, 0, 0, 0.1) 0px 0px 30px; }

.uuu-main-body { width: calc(100% - 237px); transition: 0.5s; }

.uuu-with-icon-main-body { width: calc(100% - 57px); transition: 0.5s; }

.uuu-main-body .body-content { min-height: 82vh; padding: 0px 15px 0px 10px=
; }

.uuu-left-sidebar { width: 237px; background-color: rgb(255, 255, 255); pad=
ding: 5px; height: 100vh; transition: 0.5s; }

.uuu-left-sidebar ul { position: fixed; background: rgb(255, 255, 255); z-i=
ndex: 1000; height: 94vh; width: 237px; overflow: hidden auto; transition: =
0.5s; top: 65px; }

.uuu-icon-sidebar, .uuu-icon-sidebar ul { width: 57px; transition: 0.5s; }

.uuu-left-sidebar ul::-webkit-scrollbar { width: 6px; }

.uuu-left-sidebar ul::-webkit-scrollbar-track { background: rgb(241, 241, 2=
41); }

.uuu-left-sidebar ul::-webkit-scrollbar-thumb { background: rgb(136, 136, 1=
36); }

